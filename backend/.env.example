# Reference list of backend environment variables. The backend reads them
# from the process environment (Render -> Environment, or docker-compose),
# it does NOT load this file automatically. Never commit real values.

# --- Required: the app refuses to start without these ---
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INVITE_SECRET=
# INTERNAL_CRON_SECRET must equal the REMINDER_CRON_SECRET GitHub Actions secret
INTERNAL_CRON_SECRET=
ADMIN_SECRET=

# --- Database / auth ---
DATABASE_URL=sqlite:///./data/Class_Diagram.db
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy HS256 only - prefer SUPABASE_URL (JWKS)
SUPABASE_JWT_SECRET=
# Needed for bulk therapist invites
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ---
RESEND_API_KEY=
PUBLIC_INTAKE_NOTIFY_EMAIL=

# --- Optional ---
APP_URL=
THERAPIST_APP_URL=
BOOTSTRAP_ADMIN_EMAIL=
ADMIN_FREE_SESSIONS_COUNT=4
TRUSTED_PROXY_HOPS=1
INTAKE_RATE_LIMIT_PER_IP=5
INTAKE_RATE_LIMIT_IP_WINDOW_SECONDS=600
INTAKE_RATE_LIMIT_PER_EMAIL=3
INTAKE_RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
